rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isVerifiedWorker() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'worker'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('verificationStatus', '') == 'verified';
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && (request.resource.data.role == 'patient'
          || (request.resource.data.role == 'worker'
            && request.resource.data.verificationStatus == 'pending')
          || (request.resource.data.role == 'admin'
            && request.resource.data.get('inviteCode', '') != ''
            && exists(/databases/$(database)/documents/settings/adminInvite)
            && request.resource.data.get('inviteCode', '') == get(/databases/$(database)/documents/settings/adminInvite).data.get('code', '')));
      allow update: if (isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.get('verificationStatus', null) == resource.data.get('verificationStatus', null))
        || (isAdmin()
          && resource.data.role == 'worker'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificationStatus'])
          && request.resource.data.verificationStatus in ['verified', 'pending', 'rejected']);
      allow delete: if false;
    }

    match /patients/{patientId} {
      allow read: if isVerifiedWorker() || isAdmin() || isOwner(patientId);
      allow create: if isVerifiedWorker()
        || (isOwner(patientId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.get('demo', false) == false);
      allow update: if isVerifiedWorker()
        || (isOwner(patientId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['concern', 'concernNote', 'concernAt']));
      allow delete: if isVerifiedWorker() && resource.data.get('demo', false) == true;
    }

    match /appointments/{appointmentId} {
      allow read: if isVerifiedWorker() || isAdmin()
        || (signedIn() && resource.data.patientId == request.auth.uid);
      allow create: if isVerifiedWorker()
        || (signedIn()
          && request.resource.data.patientId == request.auth.uid
          && request.resource.data.get('demo', false) == false
          && (request.resource.data.status == 'upcoming'
            || (request.resource.data.status == 'checked-in' && request.resource.data.type == 'Walk-in')));
      allow update: if isVerifiedWorker()
        || (signedIn()
          && resource.data.patientId == request.auth.uid
          && resource.data.status == 'upcoming'
          && request.resource.data.status == 'checked-in'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'checkedInAt']));
      allow delete: if isVerifiedWorker() && resource.data.get('demo', false) == true;
    }

    match /medications/{medicationId} {
      allow read: if isVerifiedWorker()
        || (signedIn() && resource.data.patientId == request.auth.uid);
      allow create: if isVerifiedWorker();
      allow update: if isVerifiedWorker()
        || (signedIn()
          && resource.data.patientId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reminder']));
      allow delete: if isVerifiedWorker();
    }

    match /notes/{noteId} {
      allow read: if isVerifiedWorker() || isAdmin();
      allow create: if isVerifiedWorker() && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if isVerifiedWorker() && resource.data.get('demo', false) == true;
    }

    match /slots/{slotId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['date', 'time', 'booked'])
        && request.resource.data.booked == 1;
      allow update: if isVerifiedWorker()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['booked'])
          && request.resource.data.booked == resource.data.booked + 1
          && request.resource.data.booked <= 2);
    }

    match /doseLogs/{logId} {
      allow read: if isVerifiedWorker() || isAdmin()
        || (signedIn() && resource.data.patientId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.status in ['taken', 'missed'];
      allow update: if signedIn()
        && resource.data.patientId == request.auth.uid
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.status in ['taken', 'missed'];
      allow delete: if false;
    }

    match /helpRequests/{requestId} {
      allow read: if isVerifiedWorker() || isAdmin()
        || (signedIn() && resource.data.patientId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.get('message', '').size() <= 300;
      allow update: if isVerifiedWorker();
      allow delete: if false;
    }

    match /settings/{document=**} {
      allow read, write: if false;
    }
  }
}
